# Copie este arquivo para ".env" e preencha os valores.
# NUNCA coloque chaves secretas aqui: tudo que começa com EXPO_PUBLIC_ vai para dentro do app
# e pode ser lido por qualquer pessoa. Veja o README para saber onde pegar cada valor.

# --- App (público) ---
# Supabase → seu projeto → botão "Connect" (topo) ou Project Settings → Data API → Project URL
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Supabase → Project Settings → API Keys → "Publishable key" (começa com sb_publishable_).
# Projetos antigos: a chave "anon public" também funciona. NUNCA use a "secret"/"service_role".
EXPO_PUBLIC_SUPABASE_ANON_KEY=cole-a-chave-publica-aqui
# Preço MOSTRADO no app, em reais, só o número (o app escreve "R$ 14,90 por mês" no idioma escolhido).
# O valor COBRADO é o segredo PREMIUM_PRICE no Supabase: mantenha os dois iguais.
EXPO_PUBLIC_PREMIUM_PRICE=14.90
# E-mail de ajuda e contato (Perfil › Ajuda e contato, telas da assinatura, reembolso e pedidos da LGPD)
EXPO_PUBLIC_SUPPORT_EMAIL=contato@exemplo.com
EXPO_PUBLIC_CVV_URL=https://cvv.org.br

# --- Servidor (segredos das Edge Functions) ---
# NÃO preencha aqui. Esses valores vão no painel do Supabase
# (Edge Functions → Secrets) a partir da Fase 3. Listados só como referência:
# LLM_PROVIDER=groq
# LLM_MODEL=
# GROQ_API_KEY=
# GEMINI_API_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# STRIPE_SECRET_KEY=      (Stripe → Desenvolvedores → Chaves de API → Chave secreta; sk_test_ no teste, sk_live_ de verdade)
# STRIPE_WEBHOOK_SECRET=  (OPCIONAL: o servidor cria o webhook sozinho. Só use se criar o destino à mão, whsec_)
# PREMIUM_PRICE=14.90     (valor cobrado por mês, em reais)
