{
  "expo": {
    "name": "Siwki",
    "slug": "pronto",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pronto",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F6F8FC",
    "ios": {
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "locales": {
      "pt-BR": "./locales/pt-BR.json",
      "en": "./locales/en.json",
      "es": "./locales/es.json",
      "fr": "./locales/fr.json",
      "de": "./locales/de.json"
    },
    "android": {
      "package": "com.guibaena.pronto",
      "adaptiveIcon": {
        "backgroundColor": "#0A5CF0",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A5CF0",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#0A5CF0"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O Siwki usa suas fotos só para você escolher a foto do seu perfil.",
          "cameraPermission": "O Siwki usa a câmera só para você tirar a foto do seu perfil.",
          "microphonePermission": false
        }
      ],
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "14b85b21-72f2-4089-a995-8a12ebd0e769"
      }
    },
    "owner": "guibaena"
  }
}
